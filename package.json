{
  "name": "mih-quality-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "export:policies": "node scripts/export-policies.mjs",
    "export:backup": "node scripts/export-policies.mjs --backup",
    "snapshot:dev": "npx --yes tsx scripts/make-dev-snapshot.ts",
    "build": "node scripts/export-policies.mjs && tsc && vite build",
    "build:ci": "npm run snapshot:dev && tsc && vite build && npm run verify:dist",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/jszip": "^3.4.0",
    "dompurify": "^3.4.17",
    "firebase": "^10.14.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
