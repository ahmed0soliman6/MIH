# ===== متغيرات بيئة Vercel (Project Settings → Environment Variables) =====

# --- تُدمج في الواجهة (عامة بطبيعتها — الحماية بقواعد Firestore و App Check) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_restricted_unsigned_preset

# --- أسرار الخادم فقط (لا تضع عليها بادئة VITE_ أبداً) ---
# تُستخدم داخل api/gemini.ts فقط
GEMINI_API_KEY=your_gemini_api_key
