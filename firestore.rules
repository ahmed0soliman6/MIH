rules_version = '2';

// ===============================================================
// MIH Quality Portal — Firestore Security Rules (v2, hardened)
// ===============================================================
// المبادئ:
//  1) المصدر الوحيد للصلاحيات: مستند /admins/{email} (البريد بحروف صغيرة).
//  2) الأدوار:  editor  → إنشاء/تعديل السياسات والحزم
//               admin   → editor + حذف السياسات + قراءة قائمة المديرين
//               superadmin → admin + إدارة المديرين (إضافة/تعديل/حذف)
//  3) لا توجد قائمة بيضاء عامة: القراءة العامة للسياسات والحزم فقط.
//  4) أي مجموعة غير مذكورة = مرفوضة افتراضياً.
//
// الإقلاع الأول (Bootstrap): أنشئ يدوياً من Firebase Console المستند
//   admins/<your-email-lowercase> = { email, role: 'superadmin', added_at: <timestamp> }
// قبل نشر هذه القواعد.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Helpers ----------------
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function emailLower() {
      return request.auth.token.email.lower();
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(emailLower());
    }

    function hasRole(roles) {
      return isSignedIn() && exists(adminPath()) && get(adminPath()).data.role in roles;
    }

    function isEditor()     { return hasRole(['editor', 'admin', 'superadmin']); }
    function isAdminRole()  { return hasRole(['admin', 'superadmin']); }
    function isSuperAdmin() { return hasRole(['superadmin']); }

    function validStringLength(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function optionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidEmail(email) {
      return email is string
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    // ---------------- Schemas ----------------
    function isValidPolicy(policyId) {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'category', 'code', 'content_html', 'plain_text', 'slides', 'updated_at', 'updated_by'])
        && d.keys().hasOnly([
          'id', 'title', 'category', 'code', 'content_html', 'plain_text', 'slides', 'updated_at', 'updated_by',
          'dept', 'version', 'date', 'effectiveDate', 'reviewDate', 'responsibilities', 'notes', 'source',
          'purpose', 'summary', 'steps', 'images', 'created_at', 'created_by', 'author_email'
        ])
        && validStringLength(d.title, 3, 250)
        && validStringLength(d.category, 2, 100)
        && validStringLength(d.code, 2, 50)
        // الحدود محسوبة بحيث لا يتجاوز المستند 1MiB (العربية ≈ 2 بايت/حرف)
        && validStringLength(d.content_html, 1, 300000)
        && validStringLength(d.plain_text, 1, 100000)
        && d.slides is list && d.slides.size() <= 100
        && d.updated_at == request.time
        && d.updated_by == emailLower()
        && (!('id' in d) || d.id == policyId)
        && optionalString(d, 'dept', 100)
        && optionalString(d, 'version', 50)
        && optionalString(d, 'date', 50)
        && optionalString(d, 'effectiveDate', 50)
        && optionalString(d, 'reviewDate', 50)
        && optionalString(d, 'responsibilities', 200)
        && optionalString(d, 'notes', 1000)
        && optionalString(d, 'source', 200)
        && optionalString(d, 'purpose', 5000)
        && optionalString(d, 'summary', 1000)
        && optionalString(d, 'created_by', 100)
        && optionalString(d, 'author_email', 100)
        && (!('steps' in d) || (d.steps is list && d.steps.size() <= 100))
        && (!('images' in d) || (d.images is list && d.images.size() <= 100))
        && (!('created_at' in d) || d.created_at is timestamp);
    }

    function isValidBundle(bundleId) {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'code', 'updated_at'])
        && d.keys().hasOnly(['id', 'title', 'code', 'updated_at', 'dept', 'goal', 'items', 'created_at', 'created_by', 'updated_by'])
        && validStringLength(d.title, 3, 250)
        && validStringLength(d.code, 2, 50)
        && d.updated_at == request.time
        && (!('id' in d) || d.id == bundleId)
        && optionalString(d, 'dept', 100)
        && optionalString(d, 'goal', 2000)
        && optionalString(d, 'created_by', 100)
        && optionalString(d, 'updated_by', 100)
        && (!('items' in d) || (d.items is list && d.items.size() <= 100))
        && (!('created_at' in d) || d.created_at is timestamp);
    }

    function isValidAdminDoc(adminEmail) {
      let d = request.resource.data;
      return d.keys().hasAll(['email', 'role', 'added_at'])
        && d.keys().hasOnly(['email', 'role', 'added_at', 'added_by', 'name', 'updated_at'])
        && d.email == adminEmail
        && adminEmail == adminEmail.lower()
        && isValidEmail(d.email)
        && d.role in ['editor', 'admin', 'superadmin']
        && optionalString(d, 'name', 100)
        && optionalString(d, 'added_by', 100);
    }

    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ---------------- Collections ----------------

    // سياسات الجودة — قراءة عامة (تصميم المنتج)، كتابة للمحررين فقط
    match /policies/{policyId} {
      allow read: if true;
      allow create: if isEditor() && isValidPolicy(policyId);
      allow update: if isEditor() && isValidPolicy(policyId) && unchanged(['created_at', 'created_by']);
      allow delete: if isAdminRole();
    }

    // حزم الرعاية
    match /bundles/{bundleId} {
      allow read: if true;
      allow create: if isEditor() && isValidBundle(bundleId);
      allow update: if isEditor() && isValidBundle(bundleId) && unchanged(['created_at', 'created_by']);
      allow delete: if isAdminRole();
    }

    // المديرون — لا قراءة عامة
    match /admins/{adminEmail} {
      // يقرأ المستخدم مستنده الشخصي فقط (لمعرفة دوره)، وadmin+ يقرأ الجميع
      allow get: if isSignedIn() && (emailLower() == adminEmail || isAdminRole());
      allow list: if isAdminRole();

      // إدارة المديرين: superadmin فقط، ولا يستطيع حذف نفسه
      allow create: if isSuperAdmin() && isValidAdminDoc(adminEmail)
        && request.resource.data.added_at == request.time
        && request.resource.data.added_by == emailLower();
      allow update: if isSuperAdmin() && isValidAdminDoc(adminEmail)
        && unchanged(['added_at', 'added_by', 'email']);
      allow delete: if isSuperAdmin() && adminEmail != emailLower();
    }

    // أي مسار آخر (بما فيه settings/*) مرفوض افتراضياً.
  }
}
